{
  "name": "mytrips",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @mytrips/web --filter @mytrips/api dev",
    "build": "pnpm --filter @mytrips/web build",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "test:e2e": "playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --if-present typecheck",
    "deploy": "pnpm build && pnpm --filter @mytrips/api run deploy"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "4.1.12"
  }
}
