{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mytrips",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Le Worker sert le build SPA de apps/web et l'API /api/* sur la même origine.
  "assets": {
    "directory": "../web/build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mytrips",
      "database_id": "503255e4-8316-4ef0-beb5-86d7ec490d4c",
      "migrations_dir": "migrations",
    },
  ],
  // R2 (binding FILES, bucket mytrips-files) sera ajouté au lot 6 (GPX) : R2 n'est pas encore activé sur le compte.
  "observability": { "enabled": true },
  // Secrets et variables de production (wrangler secret put) : ACCESS_TEAM_DOMAIN, ACCESS_AUD.
  // DEV_USER_EMAIL est réservé au développement local (.dev.vars) et ignoré si ACCESS_AUD est défini.
}
