{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mytrips",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Le Worker sert le build SPA de apps/web et l'API /api/* sur la même origine.
  "assets": {
    "directory": "../web/build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mytrips",
      "database_id": "503255e4-8316-4ef0-beb5-86d7ec490d4c",
      "migrations_dir": "migrations",
    },
  ],
  // R2 (binding FILES, bucket mytrips-files) sera ajouté au lot 6 (GPX) : R2 n'est pas encore activé sur le compte.
  "observability": { "enabled": true },
  // URL Preview désactivées : une seule URL publique (workers.dev), qui partage la base D1 de
  // production. Sans cette ligne, chaque `wrangler deploy` les réactive.
  "preview_urls": false,
  // Contact du projet dans le User-Agent du routage (politique d'usage de Transitous) : public.
  "vars": { "CONTACT_URL": "https://github.com/xor2000/appMyTrips" },
  // Secrets et variables de production (wrangler secret put) : AUTH_SECRET (signature des
  // captchas), ADMIN_EMAILS (administrateurs, e-mails séparés par des virgules).
}
